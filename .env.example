# Server configuration
PORT=3000

# GitHub Personal Access Token (Optional: Increases GitHub API rate limits for /api/github)
# Create a token with read access at https://github.com/settings/tokens
GITHUB_TOKEN=

# Upstash Redis REST API (Optional: Used for project reactions & live GitHub stats caching)
# Sign up at https://upstash.com/ and create a free Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
